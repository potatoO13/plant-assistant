page {
  min-height: 100%;
  background: #F5FAF6;
  color: #213528;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

view, text, button, input, scroll-view {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #203F2C;
  margin-bottom: 10rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #708579;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(47, 166, 106, 0.10);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  color: #203F2C;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #E8F6EE;
  color: #2FA66A;
}

.tag-warning {
  background: #FFF4DB;
  color: #B67800;
}

.tag-danger {
  background: #FFE6E2;
  color: #C94837;
}

.tag-normal {
  background: #E8F6EE;
  color: #2FA66A;
}

.btn-primary {
  background: linear-gradient(135deg, #2FA66A, #58C98B);
  color: #FFFFFF;
  border-radius: 999rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(47, 166, 106, 0.25);
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

.btn-secondary {
  background: #EFF8F2;
  color: #2FA66A;
  border-radius: 999rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8A9A8E;
  text-align: center;
  padding: 42rpx 0;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #7E9186;
}
