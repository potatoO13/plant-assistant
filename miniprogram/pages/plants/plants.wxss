.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  padding: 0 22rpx;
  background: #F5FAF6;
  color: #203F2C;
  font-size: 28rpx;
}

.search-btn {
  width: 132rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 20rpx;
  background: #2FA66A;
  color: #FFFFFF;
}

.search-btn::after {
  border: none;
}

.result-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.plant-item {
  margin-bottom: 0;
  padding: 24rpx;
  border: 2rpx solid transparent;
}

.plant-item.active {
  border-color: #2FA66A;
  background: #F0FBF4;
}

.plant-name {
  font-size: 30rpx;
  color: #203F2C;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.plant-alias {
  color: #7A8B7D;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.detail-item {
  background: #F5FAF6;
  border-radius: 20rpx;
  padding: 22rpx;
}

.detail-item.full {
  grid-column: 1 / span 2;
}

.detail-label {
  font-size: 24rpx;
  color: #7A8B7D;
  margin-bottom: 10rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #203F2C;
  font-weight: 700;
  line-height: 1.5;
}

.info-block {
  padding: 22rpx 0;
  border-top: 1rpx solid #ECF2EE;
}

.info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #203F2C;
  margin-bottom: 10rpx;
}

.info-text {
  font-size: 26rpx;
  color: #5C7162;
  line-height: 1.7;
}
