.range-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx;
}

.switch-item {
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #708579;
  background: #F5FAF6;
}

.switch-item.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #2FA66A, #58C98B);
  font-weight: 700;
}

.notice {
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.loading-notice {
  color: #2F7650;
  background: #E8F6EE;
}

.error-notice {
  color: #B13A2E;
  background: #FFEDEA;
}

.empty-notice {
  color: #7A8B7D;
  background: #FFFFFF;
}

.chart-card {
  padding-bottom: 18rpx;
}

.chart-header {
  margin-bottom: 10rpx;
}

.chart-subtitle {
  margin-top: -8rpx;
  color: #7A8B7D;
  font-size: 24rpx;
}

.chart-wrap {
  width: 100%;
  height: 520rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.summary-item {
  background: #F5FAF6;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #203F2C;
}

.summary-label {
  margin-top: 8rpx;
  color: #7A8B7D;
  font-size: 22rpx;
}
