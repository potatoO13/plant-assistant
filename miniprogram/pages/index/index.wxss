.overview-card {
  background: linear-gradient(135deg, #E8F6EE, #FFFFFF);
}

.overview-label {
  font-size: 24rpx;
  color: #6B8171;
}

.device-id {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #203F2C;
}

.update-line {
  margin-top: 22rpx;
  color: #6B8171;
  font-size: 24rpx;
}

.notice {
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.loading-notice {
  color: #2F7650;
  background: #E8F6EE;
}

.error-notice {
  color: #B13A2E;
  background: #FFEDEA;
}

.empty-notice {
  color: #7A8B7D;
  background: #FFFFFF;
}

.light-card {
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FFF7DC, #FFFFFF 72%);
  box-shadow: 0 16rpx 40rpx rgba(242, 163, 58, 0.16);
  border: 2rpx solid #FFE4A5;
}

.light-label {
  font-size: 28rpx;
  color: #7A682D;
}

.light-value {
  margin-top: 12rpx;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 900;
  color: #233C2A;
}

.light-unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #957633;
  font-weight: 700;
}

.light-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8A7A43;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-bottom: 26rpx;
}

.metric-card {
  min-height: 168rpx;
  padding: 26rpx 22rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 36rpx rgba(47, 166, 106, 0.10);
}

.metric-label {
  color: #7A8B7D;
  font-size: 24rpx;
}

.metric-value {
  margin-top: 18rpx;
  color: #203F2C;
  font-size: 42rpx;
  font-weight: 800;
}

.metric-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #7A8B7D;
}

.metric-time {
  margin-top: 18rpx;
  color: #203F2C;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 700;
  word-break: break-all;
}

.refresh-btn {
  margin: 4rpx 0 24rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

.quick-button {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  color: #2FA66A;
  background: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(47, 166, 106, 0.10);
}

.quick-button::after {
  border: none;
}
